# 이 파일을 .env 로 복사한 뒤 값을 채운다.  (cp .env.example .env)
# .env 는 Git에 올리지 않는다. 운영 서버에서는 같은 이름의 환경 변수로 주입한다.

# --- MySQL 8.x (TC-007) ---
DB_URL=jdbc:mysql://localhost:3306/cstudy?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=cstudy
DB_PASSWORD=cstudy-local

# --- JWT (QC-003) : 32바이트 이상 무작위 문자열.  생성 예) openssl rand -base64 48 ---
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# --- CORS (TC-009) : 프론트엔드 주소. 여러 개면 쉼표로 구분 ---
FRONTEND_ORIGINS=http://localhost:5173

# --- 영상·이미지 파일 주소 (TC-007) ---
# 로컬: 백엔드가 프로젝트의 media 폴더를 S3 대신 서빙한다.
# 운영: MEDIA_SERVE_LOCAL 을 빼고(또는 false), MEDIA_BASE_URL 을 S3 버킷(또는 CloudFront) 주소로 교체.
#       예) MEDIA_BASE_URL=https://my-bucket.s3.ap-northeast-2.amazonaws.com
MEDIA_BASE_URL=http://localhost:8080
MEDIA_SERVE_LOCAL=true
MEDIA_LOCAL_DIR=../media

# --- 최초 운영자 계정 (시작 시 없으면 생성, 비밀번호는 BCrypt 해시로 저장) ---
ADMIN_ID=admin
ADMIN_PASSWORD=change-me
